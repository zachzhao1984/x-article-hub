---
// SPEC §33 — every page needs title / description / canonical / OpenGraph /
// Twitter Card. Centralised so no page can forget.
export interface Props {
  title: string;
  description: string;
  /** Absolute path, e.g. /article/foo. Converted to an absolute URL here. */
  path: string;
  type?: 'website' | 'article';
  publishedAt?: number | null;
  authorName?: string | null;
  noindex?: boolean;
}

import { env } from 'cloudflare:workers';
import { MANIFEST_HREF, SITE_ICONS, THEME_COLOR } from '../config/icons';
import { THEME_BODY_SCRIPT, THEME_HEAD_SCRIPT } from '../lib/theme';

const SITE_NAME = (env.SITE_NAME as string) || 'X Article Hub';
const ORIGIN = ((env.SITE_ORIGIN as string) || 'https://x-article-hub.workers.dev').replace(/\/+$/, '');

const { title, description, path, type = 'website', publishedAt, authorName, noindex = false } = Astro.props;

const canonical = new URL(path, ORIGIN).href;
const fullTitle = path === '/' ? `${SITE_NAME} — curated X Articles` : `${title} · ${SITE_NAME}`;
const iso = publishedAt ? new Date(publishedAt).toISOString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {iso && <meta property="article:published_time" content={iso} />}
    {authorName && <meta property="article:author" content={authorName} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="stylesheet" href="/site.css" />

    {SITE_ICONS.map((icon) => <link {...icon} />)}
    <link rel="manifest" href={MANIFEST_HREF} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={THEME_COLOR} />

    {/*
      Applies the stored theme before first paint.

      This has to be a synchronous inline script in <head>, ahead of the
      stylesheet's first use. A deferred or module script runs after the HTML is
      parsed and the page has already painted at least once, which is exactly the
      white-flash-then-dark flash this exists to prevent — the stylesheet cannot
      know the reader's choice until something tells it, and by the time a deferred
      script runs that something is too late.

      The body of the script lives in `lib/theme.ts` rather than here, because the
      admin surface renders its own HTML and needs the same two scripts; see that
      module for why one copy beats two. `is:inline` is what keeps this synchronous
      — an Astro-processed script would be bundled, deferred, and too late.
    */}
    <script is:inline set:html={THEME_HEAD_SCRIPT} />

    <slot name="head" />
  </head>
  <body>
    <slot />
    {/*
      Applies a change from the switcher, then remembers it. Shared with the admin
      surface — see `lib/theme.ts`. Applying is not optional and was the bug this
      replaced: the handler used to only write localStorage and the cookie, on the
      assumption that the radio's `:checked` state plus CSS would repaint the page.
      It does not — that rule only highlights the control. The theme is driven by
      `data-theme` on <html>, which nothing was writing, so clicking "dark" moved
      the highlight and left the page light until a reload.
    */}
    <script is:inline set:html={THEME_BODY_SCRIPT} />
  </body>
</html>
