---
// SPEC §17.2 — the reading page.
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import InlineText from '../../components/InlineText.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { getPublishedArticleBySlug, getArticleTags, listPublishedArticles } from '../../db/public';
import { readArticleDocument } from '../../services/archive';
import { i18nSpread } from '../../lib/i18n';
import type { ArticleBlock } from '../../types/article-document';
import { inlineToText } from '../../types/article-document';

const db = env.DB as unknown as D1Database;
const bucket = env.ARCHIVE as unknown as R2Bucket;
const { slug = '' } = Astro.params;

const article = await getPublishedArticleBySlug(db, slug);

if (!article) {
  return Astro.rewrite('/404');
}

/** A cover's alt text is generated boilerplate, not a caption worth rendering. */
function isCoverCaption(alt?: string): boolean {
  return !alt || /^(article )?cover image$/i.test(alt.trim());
}

const isTakedown = article.status === 'takedown' || article.display_mode === 'takedown';
// SPEC §37 — the body is only rendered for `full`. `excerpt` and `link_only`
// deliberately do not fetch the R2 document at all.
const showBody = !isTakedown && article.display_mode === 'full';

const [tags, document, related] = await Promise.all([
  getArticleTags(db, article.id),
  showBody && article.content_r2_key ? readArticleDocument(bucket, article.content_r2_key) : Promise.resolve(null),
  listPublishedArticles(db, {
    categorySlug: article.category_slug ?? undefined,
    limit: 4,
  }),
]);

const related_ = related.filter((r) => r.id !== article.id).slice(0, 3);

/** The first paragraph's words with its inline markup stripped, for the meta description. */
const firstParagraphText = (doc: typeof document): string | null => {
  const first = doc?.blocks.find((b) => b.type === 'paragraph');
  return first && first.type === 'paragraph' ? inlineToText(first.spans) : null;
};

const description =
  article.excerpt ||
    (firstParagraphText(document)?.slice(0, 200) ?? null) ||
  article.title;

const readingMinutes = Math.max(1, Math.round(article.word_count / 220));

// SPEC §33 — canonical points at our archive; the X link is separate and explicit.
const jsonLd = isTakedown
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: article.title,
      description,
      datePublished: article.published_at ? new Date(article.published_at).toISOString() : undefined,
      author: article.author_username
        ? { '@type': 'Person', name: article.author_name ?? article.author_username, url: `/author/${article.author_username}` }
        : undefined,
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, env.SITE_ORIGIN).href },
      isBasedOn: article.canonical_url,
      wordCount: article.word_count,
      keywords: tags.map((t) => t.name).join(', ') || undefined,
    };
---

<Base
  title={article.title}
  description={description}
  path={`/article/${article.slug ?? slug}`}
  type="article"
  publishedAt={article.published_at}
  authorName={article.author_name ?? article.author_username}
>
  {jsonLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />}
  <meta name="referrer" content="no-referrer" slot="head" />

  <SiteHeader>
    <div class="article-shell">
      <nav class="article-crumbs">
        {article.category_name && article.category_slug && (
          <>
            <a class="tag-cat" href={`/category/${article.category_slug}`}>{article.category_name}</a>
            <span class="muted">/</span>
          </>
        )}
        <a href="/latest" {...i18nSpread('article.latest')}>Latest</a>

        {/*
          SPEC §43 — the save control.

          Rendered empty and filled from the API, because this page is served with
          `s-maxage=3600`: anything the server rendered about the reader would be baked into
          a cached document and handed to everyone. Same reasoning as the header's account
          slot, and the reason this is a `<span data-save-slot>` rather than a conditional
          in the template.

          It sits in the crumbs row so it is visible before the reader starts, which is where
          the decision to keep something is usually made.
        */}
        <span class="save-slot" data-save-slot data-article-id={article.id}></span>
      </nav>

      <header class="article-head">
        <h1 class="article-title">{article.title}</h1>
        <div class="byline">
          {
            /* SPEC §10 — the pipeline rewrites author_avatar to a local
               /media path once the portrait is in R2. A bare x.com URL here
               means it is not archived yet. */
            article.author_avatar &&
              (article.author_avatar.startsWith('http') ? (
                <img
                  class="avatar is-remote"
                  src={article.author_avatar}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />
              ) : (
                <img class="avatar" src={article.author_avatar} alt="" width="40" height="40" loading="lazy" />
              ))
          }
          {article.author_username && (
            <a class="author-name" href={`/author/${article.author_username}`}>
              {article.author_name ?? ''}
              <span class="handle">@{article.author_username}</span>
            </a>
          )}
          {article.published_at && (
            <time datetime={new Date(article.published_at).toISOString()}>
              {new Date(article.published_at).toISOString().slice(0, 10)}
            </time>
          )}
          <span class="muted">{readingMinutes} <span {...i18nSpread('card.minRead')}>min read</span></span>
        </div>
      </header>

      {
        isTakedown ? (
          // SPEC §37 — a takedown is explained, not hidden. A shared link should
          // not silently look like a broken page.
          <div class="notice">
            <h2 {...i18nSpread('article.takenDown')}>This article has been taken down</h2>
            <p {...i18nSpread('article.takenDownBody')}>
              The archived copy is no longer displayed. This usually means the author requested removal, or
              the content raised a rights concern.
            </p>
            {article.takedown_reason && <p><strong {...i18nSpread('article.reason')}>Reason:</strong> {article.takedown_reason}</p>}
          </div>
        ) : (
          <>
            {
              (article.final_score !== null || article.quality_score !== null) && (
                <div class="stat-row">
                  {article.final_score !== null && <span><span {...i18nSpread('article.score.final')}>Final</span> <b>{article.final_score.toFixed(0)}</b></span>}
                  {article.popularity_score !== null && <span><span {...i18nSpread('article.score.popularity')}>Popularity</span> <b>{article.popularity_score.toFixed(0)}</b></span>}
                  {article.quality_score !== null && <span><span {...i18nSpread('article.score.quality')}>Quality</span> <b>{article.quality_score.toFixed(0)}</b></span>}
                </div>
              )
            }

            {article.display_mode === 'link_only' ? (
              <div class="notice">
                <h2 {...i18nSpread('article.fullTextHidden')}>Full text not displayed</h2>
                <p {...i18nSpread('article.fullTextHiddenBody')}>
                  This archive does not republish the full text of this article. Read it at the original
                  source instead.
                </p>
              </div>
            ) : (
              article.editor_summary && <div class="notice"><p>{article.editor_summary}</p></div>
            )}

            {
              article.display_mode === 'excerpt' && (
                <div class="notice">
                  <p><strong {...i18nSpread('article.excerptOnly')}>Excerpt only.</strong> <span {...i18nSpread('article.excerptNote')}>The full text is archived but not published.</span></p>
                </div>
              )
            }

            <div class="article-body">
              {
                showBody && document
                  ? document.blocks.map((block: ArticleBlock) => {
                      switch (block.type) {
                        case 'heading':
                          const Tag = `h${Math.max(1, block.level - 1)}` as 'h1' | 'h2';
                          return (
                            <Tag>
                              <InlineText spans={block.spans} />
                            </Tag>
                          );
                        case 'quote':
                          return (
                            <blockquote>
                              <InlineText spans={block.spans} />
                            </blockquote>
                          );
                        case 'list':
                          return block.ordered ? (
                            <ol>{block.items.map((i) => <li><InlineText spans={i} /></li>)}</ol>
                          ) : (
                            <ul>{block.items.map((i) => <li><InlineText spans={i} /></li>)}</ul>
                          );
                        case 'code':
                          return <CodeBlock code={block.code} language={block.language} />;
                        case 'image': {
                          const img = document.images.find((i) => i.imageId === block.imageId);
                          if (!img) return null;

                          // Play video directly from its original host, with a fallback link.
                          //
                          // It used to fall through to the "Image not archived" branch
                          // below, which is written for an image whose download failed —
                          // and for a video that sentence is false twice over: nothing was
                          // archived because nothing was ever fetched, and nothing is
                          // going to break. Meanwhile the `<figure>` reserved a box, so
                          // the reader saw an image slot claiming to still work rather
                          // than the recording they came for.
                          //
                          // The URL is X's own and stays pointed at X: there is nothing
                          // at /media to rewrite it to. `nofollow` for the same reason the
                          // original-link chain carries it — this page should not pass
                          // authority to a CDN.
                          if (img.status === 'video') {
                            return (
                              <div class="fig-video">
                                <video
                                  src={img.sourceUrl}
                                  controls
                                  playsinline
                                  preload="metadata"
                                  aria-label={img.altText || 'Video'}
                                />
                                <a
                                  href={img.sourceUrl}
                                  target="_blank"
                                  rel="noopener noreferrer nofollow"
                                  {...i18nSpread('article.videoLink')}
                                >
                                  Watch the video on x.com
                                </a>
                                {img.altText && <span>{img.altText}</span>}
                                <span {...i18nSpread('article.videoNote')}>the recording is not archived here; this link goes to X</span>
                              </div>
                            );
                          }

                          // SPEC §10 — the page serves every image from /media, which
                          // reads R2. Only an image the pipeline gave up on still
                          // points at X, and that case says so out loud instead of
                          // quietly hotlinking: a reader cannot tell a working image
                          // from one that breaks the day X drops it.
                          const archived = Boolean(img.r2Key);
                          return (
                            <figure
                              class:list={[
                                'fig',
                                { cover: isCoverCaption(img.altText), fallback: !archived },
                              ]}
                            >
                              {archived ? (
                                <img
                                  src={`/media/${img.imageId}`}
                                  alt={img.altText ?? ''}
                                  loading="lazy"
                                  decoding="async"
                                  // Reserves the box from the stored dimensions, so
                                  // the article does not reflow as images arrive.
                                  width={img.width ?? undefined}
                                  height={img.height ?? undefined}
                                />
                              ) : (
                                <a
                                  class="fig-missing"
                                  href={img.sourceUrl}
                                  target="_blank"
                                  rel="noopener noreferrer nofollow"
                                >
                                  <span {...i18nSpread('article.imageMissing')}>Image not archived</span>
                                  <span {...i18nSpread('article.imageNote')}>this figure still loads from x.com and may stop working</span>
                                </a>
                              )}
                              {img.altText && !isCoverCaption(img.altText) && (
                                <figcaption>{img.altText}</figcaption>
                              )}
                            </figure>
                          );
                        }
                        case 'paragraph':
                          return (
                            <p>
                              <InlineText spans={block.spans} />
                            </p>
                          );
                        case 'embed':
                          return (
                            <blockquote class="embedded-post">
                              {block.author && <strong>{block.author}</strong>}
                              {block.text && <p>{block.text}</p>}
                              {block.videoUrl && (
                                <video src={block.videoUrl} poster={block.poster} controls playsinline preload="metadata" aria-label={block.author || 'X video'} />
                              )}
                              <a href={block.url || `https://x.com/i/web/status/${block.postId}`} target="_blank" rel="noopener noreferrer nofollow">X ↗</a>
                            </blockquote>
                          );
                        default:
                          return null;
                      }
                    })
                  : null
              }
              {
                showBody && !document && (
                  <div class="notice">
                    <p {...i18nSpread('article.noDocument')}>The archived document for this article is not available yet.</p>
                  </div>
                )
              }
            </div>

            <footer class="article-footer">
              {
                tags.length > 0 && (
                  <div class="tag-row">
                    {tags.map((t) => (
                      <a class="tag" href={`/tag/${t.slug}`}>{t.name}</a>
                    ))}
                  </div>
                )
              }

              <!-- SPEC §33 — the X link is explicit and separate from our canonical. -->
              <a class="original-link" href={article.canonical_url} target="_blank" rel="noopener noreferrer nofollow" {...i18nSpread('article.viewOriginal')}>
                ↗ View original on X
              </a>

              {/* SPEC §43 — the same control again, for someone who decided at the end. */}
              <span class="save-slot" data-save-slot data-article-id={article.id}></span>
            </footer>
          </>
        )
      }

      {
        related_.length > 0 && !isTakedown && (
          <section class="board" style="margin-top:56px">
            <h2 class="board-title" {...i18nSpread('article.moreIn', { category: article.category_name ?? 'this topic' })}>More in {article.category_name ?? 'this topic'}</h2>
            <div class="grid-cards">
              {related_.map((r) => (
                <ArticleCard article={r} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </SiteHeader>

  {/*
    SPEC §43 — fill every save slot on the page.

    One script for both, addressing them by `[data-save-slot]` rather than by id: the two
    controls must agree, and a reader who saves at the top has to see the bottom button
    change without a reload. Rendering them all from a single call is what stops them
    drifting — a second copy of this code is how one of them ends up showing the wrong state.

    Nothing is drawn for a signed-out reader. A save button that cannot save is a worse
    invitation than no button, and the header already offers sign-in.
  */}
  <script is:inline define:vars={{ saveText: i18nSpread('article.save'), savedText: i18nSpread('article.saved') }}>
    (function () {
      // SPEC §17.4 — the reader's language is read *here*, in the browser, not through
      // `define:vars`. `define:vars` evaluates its object while rendering the page, on the
      // server, where `document` does not exist: computing it there threw and turned every
      // article page into a 500. Only serialisable values may cross that boundary, so the
      // cookie is read inside the script that runs after it.
      var lang = (function () {
        try {
          var m = document.cookie.match(/(?:^|; )xah_lang=([^;]*)/);
          return m ? decodeURIComponent(m[1]) : 'en';
        } catch (e) { return 'en'; }
      })();

      var slots = document.querySelectorAll('[data-save-slot]');
      if (slots.length === 0) return;
      var articleId = slots[0].getAttribute('data-article-id');
      if (!articleId) return;

      // SPEC §17.4 — the button text is created in the reader's language. The strings come
      // from the same catalog the server rendered, so the script and the page cannot
      // disagree about what the control is called.
      function tr(attrs) {
        return lang === 'en' ? attrs['data-i18n-en'] : (attrs['data-i18n-' + lang] || attrs['data-i18n-en']);
      }
      function applyI18n(el, attrs) {
        for (var k in attrs) { if (attrs.hasOwnProperty(k)) el.setAttribute(k, attrs[k]); }
      }

      function render(state) {
        for (var i = 0; i < slots.length; i++) {
          var slot = slots[i];
          if (!state.authenticated) {
            // Signed out: nothing at all. See the note above.
            slot.replaceChildren();
            continue;
          }
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'save-button' + (state.saved ? ' is-saved' : '');
          button.setAttribute('aria-pressed', state.saved ? 'true' : 'false');
          button.textContent = state.saved ? tr(savedText) : tr(saveText);
          applyI18n(button, state.saved ? savedText : saveText);
          button.addEventListener('click', function () {
            submit(!state.saved);
          });
          slot.replaceChildren(button);
        }
      }

      function submit(save) {
        fetch('/auth/saved/' + encodeURIComponent(articleId), {
          method: save ? 'POST' : 'DELETE',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' },
        })
          .then(function (res) {
            if (res.status === 401) {
              // The session went away between render and click. Sending the reader to sign in
              // is the only useful response; failing silently would look like a broken button.
              window.location.href = '/account?next=' + encodeURIComponent(window.location.pathname);
              return null;
            }
            return res.ok ? res.json() : null;
          })
          .then(function (body) {
            if (!body) return;
            // The server's answer, not the optimistic one: saving twice must leave both
            // buttons reading saved rather than one of them flipped back.
            render({ authenticated: true, saved: body.saved === true });
          })
          .catch(function () {
            // Offline. The buttons keep the last state the server confirmed, so they are
            // stale rather than wrong.
          });
      }

      fetch('/auth/saved/' + encodeURIComponent(articleId), {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) {
          return res.ok ? res.json() : null;
        })
        .then(function (body) {
          if (!body) return;
          render({ authenticated: body.authenticated === true, saved: body.saved === true });
        })
        .catch(function () {
          // Offline: leave the slots empty. They are decoration until the state is known.
        });
    })();
  </script>
</Base>
