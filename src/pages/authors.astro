---
/**
 * SPEC §17.1 — /authors
 *
 * Everyone with at least one published article, most prolific first. Each entry links to
 * the archive filtered to that person, which is the same page the byline on every card
 * already links to.
 *
 * ## Where the list comes from
 *
 * `listAuthors` aggregates `articles.author_username` rather than reading the `authors`
 * table, and that is the whole reason this page can exist. `authors` holds rows only for
 * the demo seed — `seed-demo.ts` is the only writer — so on a real archive it is empty
 * while every article still carries its author. The `articles` side is also what
 * `/author/[username]` reads, so this list and that page cannot disagree about who exists
 * or how many articles they have.
 *
 * The count is deliberately the same predicate the author page uses: published, not
 * taken down, and with a username. An author whose only article is a takedown therefore
 * appears on neither, which is correct — the alternative is a name here whose page
 * renders an empty grid.
 */
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { listAuthors } from '../db/public';

const db = env.DB as unknown as D1Database;

// Ordered by article count, so a single `limit` takes the most prolific. The archive is
// small enough that this is everyone; the cap exists so the page cannot grow without
// bound and is high enough that it would be a surprise if it ever truncated.
const AUTHORS_SHOWN = 200;
const authors = await listAuthors(db, AUTHORS_SHOWN);
const totalArticles = authors.reduce((sum, a) => sum + a.article_count, 0);

const description =
  authors.length === 0
    ? 'The people behind the articles in this archive.'
    : `${authors.length} author${authors.length === 1 ? '' : 's'} and ${totalArticles} archived X Article${totalArticles === 1 ? '' : 's'}.`;

/**
 * `display_name` is nullable and Google/X names are not handles, so fall back to the
 * handle the link already uses. A blank heading is the failure this avoids.
 */
const labelFor = (author: { display_name: string | null; username: string }) =>
  author.display_name?.trim() || `@${author.username}`;
---

<Base title="Authors" description={description} path="/authors">
  <SiteHeader>
    <header class="hero">
      <h1>Authors</h1>
      <p class="hero-sub">
        {
          authors.length === 0
            ? 'Nobody has published here yet.'
            : `${authors.length} author${authors.length === 1 ? '' : 's'} · ${totalArticles} article${totalArticles === 1 ? '' : 's'} archived`
        }
      </p>
    </header>

    {
      authors.length === 0 ? (
        <p class="empty-state">No authors yet — the archive is empty.</p>
      ) : (
        <ul class="author-grid">
          {authors.map((author) => (
            <li class="author-card">
              {/*
                One link wrapping the avatar and the name, rather than two links to the
                same place. Two would hand a screen reader the same destination twice and
                give a keyboard two tab stops for one choice.

                The avatar is decorative — the name beside it is the label, so an empty
                alt keeps it from being announced as a filename. The letter stands in when
                there is no picture, which is the same fallback the header slot uses: the
                image column is fixed width in the grid, and an empty column reads as a
                broken row rather than as a missing avatar.
              */}
              <a class="author-link" href={`/author/${author.username}`}>
                {author.avatar_url ? (
                  <img
                    class="author-avatar"
                    src={author.avatar_url}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="author-avatar author-avatar-letter" aria-hidden="true">
                    {labelFor(author).charAt(0).toUpperCase()}
                  </span>
                )}
                <span class="author-meta">
                  <span class="author-display">{labelFor(author)}</span>
                  <span class="author-handle">
                    @{author.username} · {author.article_count} article
                    {author.article_count === 1 ? '' : 's'}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </SiteHeader>
</Base>
