---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { i18nSpread } from '../lib/i18n';
---

<Base title="Not found" description="This page does not exist." path={Astro.url.pathname} noindex>
  <SiteHeader>
    <div class="empty-state">
      <h2 {...i18nSpread('notFound.heading')}>404 — not found</h2>
      <p>
        <span {...i18nSpread('notFound.body')}>That page does not exist, or the article was never published. Try</span>{' '}
        <a href="/" {...i18nSpread('notFound.homepage')}>the homepage</a>,
        <a href="/latest" {...i18nSpread('notFound.latest')}>Latest</a>, or <a href="/search" {...i18nSpread('notFound.search')}>search</a>.
      </p>
    </div>
  </SiteHeader>
</Base>
