---
// The Shelf: four ranked articles, followed by six distinct recent articles.
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import RackTile from '../components/RackTile.astro';
import { listPublishedArticles, homepageCounts, listCategoriesWithCounts } from '../db/public';
import { i18nSpread, i18nAttrSpread } from '../lib/i18n';

const db = env.DB as unknown as D1Database;

const [lead, newest, newCount, cats, authors] = await Promise.all([
  listPublishedArticles(db, { sort: 'trending', limit: 4 }),
  listPublishedArticles(db, { sort: 'latest', limit: 12 }),
  homepageCounts(db),
  listCategoriesWithCounts(db),
  db.prepare(`SELECT COUNT(DISTINCT author_username) AS total FROM articles
    WHERE status = 'published' AND display_mode != 'takedown'`).first<{ total: number }>(),
]);

const empty = newest.length === 0;

const [feature, ...rest] = lead;
const rackSide = rest.slice(0, 3);

const onRack = new Set(lead.map((a) => a.id));
const justArchived = newest.filter((a) => !onRack.has(a.id)).slice(0, 6);

const topics = cats.filter((c) => c.count > 0);
const authorCount = authors?.total ?? 0;
const articleCount = newCount.total;


---

<Base
  title="X Article Hub"
  description="A human-curated, machine-archived library of X Articles — organized by topic, ranked by real engagement."
  path="/"
>
  <SiteHeader>
    <div class="home-shelf">
    {empty ? (
      <div class="empty-state">
        <h1 {...i18nSpread('home.noArticles')}>No published articles yet</h1>
        <p>
          <span {...i18nSpread('home.noArticlesBody')}>
            Articles appear here after they are imported and parsed. Paste X Article URLs in the
          </span>{' '}
          <a href="/admin/import" {...i18nSpread('home.importer')}>admin importer</a>{' '}
          <span {...i18nSpread('home.startPipeline')}>to start the pipeline.</span>
        </p>
        <pre><code>https://x.com/username/article/1234567890</code></pre>
      </div>
    ) : (
      <>

        <h1 class="sr-only">X Article Hub</h1>

        <section class="rack" aria-labelledby="rack-heading">
          <div class="rack-head">
            <h2 class="rack-heading" id="rack-heading" {...i18nSpread('home.trending')}>Trending</h2>
            <p class="rack-meta">
              <span {...i18nSpread('home.archivedCount', { n: articleCount })}>{articleCount} archived</span>

            </p>
            <a class="rack-more" href="/trending" {...i18nSpread('home.allTrending')}>All trending →</a>
          </div>

          <div class="rack-grid">
            {feature && <RackTile article={feature} weight="lead" flag="home.rackLead" ordinal={null} slot={1} />}
            {rackSide.map((article, i) => (
              <RackTile
                article={article}
                weight={i === 0 ? 'feature' : 'side'}
                ordinal={i + 2}
                slot={(i + 2) as 2 | 3 | 4}
              />
            ))}
          </div>
        </section>

        {justArchived.length > 0 && (
          <section class="strip" aria-labelledby="strip-heading">
            <div class="strip-head">
              <h2 class="strip-heading" id="strip-heading" {...i18nSpread('home.justArchived')}>Just archived</h2>
              <p class="strip-meta" {...i18nSpread('home.archiveLine', { articles: articleCount, authors: authorCount, topics: topics.length })}>
                {articleCount} articles · {authorCount} authors · {topics.length} topics
              </p>
              <a class="strip-more" href="/latest" {...i18nSpread('home.seeAll')}>All latest →</a>
            </div>
            <ul class="strip-grid">
              {justArchived.map((article, i) => (
                <li>
                  <a class="strip-item" href={article.slug ? `/article/${article.slug}` : '#'}>
                    <span class="strip-shot">
                      {i < 9 && <span class="strip-ordinal">{String(i + 1).padStart(2, '0')}</span>}
                      {article.cover_image_id ? (
                        <img src={`/media/${article.cover_image_id}`} alt="" loading="lazy" decoding="async" />
                      ) : (
                        <span class="strip-noshot" aria-hidden="true" />
                      )}
                    </span>
                    <span class="strip-title">{article.title}</span>
                    <span class="strip-by">
                      {article.author_username && <span>@{article.author_username}</span>}
                      <span aria-hidden="true">·</span>
                      <span>{Math.max(1, Math.round(article.word_count / 220))} <span {...i18nSpread('card.minRead')}>min read</span></span>
                      {article.featured === 1 && (
                        <span class="strip-pick" {...i18nSpread('home.editorsPick')}>Editor's pick</span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {topics.length > 0 && (
          <nav class="topics-line" aria-label="Topics" {...i18nAttrSpread('aria-label', 'home.topics')}>
            <span class="topics-label" {...i18nSpread('home.topics')}>Topics</span>
            {topics.map((t, i) => (
              <>
                {i > 0 && <span class="topics-sep" aria-hidden="true">/</span>}
                <a href={`/category/${t.slug}`}>
                  {t.name} <span class="topics-count">{t.count}</span>
                </a>
              </>
            ))}
          </nav>
        )}
      </>
    )}
    </div>
  </SiteHeader>
</Base>
