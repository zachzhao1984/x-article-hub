---
// SPEC §17.1 — /about
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { homepageCounts } from '../db/public';
import { i18nSpread } from '../lib/i18n';

const db = env.DB as unknown as D1Database;
const counts = await homepageCounts(db);
---

<Base
  title="About"
  description="How X Article Hub works: human curation, machine archiving, transparent ranking."
  path="/about"
>
  <SiteHeader>
    <article class="prose">
      <h1 {...i18nSpread('about.title')}>About</h1>

      <p>
        <span {...i18nSpread('about.intro')}>
          X Article Hub is an archive of long-form posts from X, chosen by a human and organized by
          machines. It is currently holding
        </span> <strong>{counts.total}</strong>{' '}
        <span {...i18nSpread('about.introCount')}>published articles.</span>
      </p>

      <h2 {...i18nSpread('about.how')}>How an article gets here</h2>
      <ol>
        <li>
          <span {...i18nSpread('about.step1')}>An editor pastes an X Article URL into the</span>{' '}
          <a href="/admin/import" {...i18nSpread('about.importer')}>importer</a>.
        </li>
        <li {...i18nSpread('about.step2')}>The URL is normalized and de-duplicated by its canonical form.</li>
        <li {...i18nSpread('about.step3')}>A crawl job fetches the rendered page and archives the raw HTML and Markdown.</li>
        <li {...i18nSpread('about.step4')}>A parser converts that into a structured document, preserving the author's structure.</li>
        <li {...i18nSpread('about.step5')}>A successfully parsed article is published automatically.</li>
        <li {...i18nSpread('about.step6')}>AI suggests a category; editors can adjust it or remove an article.</li>
      </ol>

      <h2 {...i18nSpread('about.rank')}>How articles are ranked</h2>
      <p {...i18nSpread('about.rankIntro')}>
        Three signals are kept separate and blended with configurable weights, so no single
        number decides what you see. A fourth, time decay, favours recent articles so the
        boards keep moving:
      </p>
      <ul>
        <li {...i18nSpread('about.rankPopularity')}><strong>Popularity</strong> — log-compressed likes, reposts, replies, quotes, bookmarks and views.</li>
        <li {...i18nSpread('about.rankQuality')}><strong>Quality</strong> — an AI assessment that can inform ranking but never publishes anything.</li>
        <li {...i18nSpread('about.rankEditor')}><strong>Editor score</strong> — a human override.</li>
      </ul>
      <p {...i18nSpread('about.rankOutro')}>
        <a href="/trending">Trending</a> uses the blend. <a href="/latest">Latest</a> is strictly chronological.
        Editor's Picks are a human decision and are not a ranking. <a href="/authors">Authors</a> is every writer
        in the archive, most prolific first.
      </p>

      <h2 {...i18nSpread('about.rights')}>Content and rights</h2>
      <p {...i18nSpread('about.rightsBody')}>
        Articles here are archived copies of work written by other people. Each reading page links
        back to the original. Successfully parsed imports are published automatically. Editors can
        limit an article to an excerpt or link, or take it down at any time.
      </p>

      <h2 {...i18nSpread('about.built')}>Built on Cloudflare</h2>
      <p {...i18nSpread('about.builtBody')}>
        Workers, D1, R2, Queues, Browser Run and Workers AI. No external search cluster, no
        self-hosted browser fleet, no separate VPS.
      </p>
    </article>
  </SiteHeader>
</Base>
