---
/**
 * SPEC §33 — a three-state theme control: light, dark, follow the system.
 *
 * Built as radios so the selected state lives in the form, not in JavaScript. CSS
 * does the highlighting (`:has(input:checked)`), which means the control renders
 * and responds correctly before — and without — any script, and stays keyboard
 * navigable. The inline script in Base.astro reads the stored choice and writes
 * `data-theme` before first paint; this component only persists a change.
 *
 * The `system` option deliberately does not clear the attribute. It writes the
 * value `system`, and the stylesheet treats anything other than `light`/`dark` as
 * "no explicit choice", so the media query governs. Deleting the attribute instead
 * would leave `:root[data-theme='light']` matching nothing while the media query's
 * `:root:not([data-theme='light'])` also stopped applying, which is a subtle way to
 * lose the light theme on a dark-mode machine.
 */
export interface Props {
  /** The choice persisted by the last visit, so the control starts in the right state. */
  current?: ThemeChoice;
}

import Icon from './Icon.astro';
import { THEME_OPTIONS } from '../lib/theme';
import type { ThemeChoice } from '../lib/theme';
import { TRANSLATIONS, i18nSpread, i18nAttrSpread } from '../lib/i18n';

const { current = 'system' } = Astro.props;

/**
 * The theme labels, translated (SPEC §17.4).
 *
 * The English comes from `THEME_OPTIONS` as before; the other two are looked up from the
 * catalog by a small map, so the two surfaces that render this control (the public header
 * and the admin) still agree on the option list while the *words* can differ by language.
 * The admin is not translated, so it keeps showing `THEME_OPTIONS`' labels.
 */
const THEME_KEYS: Record<ThemeChoice, 'theme.light' | 'theme.dark' | 'theme.system'> = {
  light: 'theme.light',
  dark: 'theme.dark',
  system: 'theme.system',
};

/**
 * The three choices come from `lib/theme.ts`, not from here.
 *
 * They used to be hand-written paths on a 24 grid, stroked, sitting about 400px from
 * the navigation's glyphs — two icon systems with two grids and two fill models in one
 * 58px-tall bar. They then lived here alone, which was fine until the admin grew the
 * same control; now the list is the shared one so the two surfaces cannot disagree about
 * what the third option is called or which glyph means it.
 *
 * 15px rather than the nav's 18px because these sit in a segmented control where the box
 * is fixed and a larger glyph crowds its neighbours.
 */
const OPTIONS = THEME_OPTIONS;
---

<fieldset class="theme-switch">
  <legend class="visually-hidden" {...i18nSpread('theme.legend')}>Colour theme</legend>
  <div
    class="theme-switch__options"
    role="radiogroup"
    aria-label="Colour theme"
    {...i18nAttrSpread('aria-label', 'theme.legend')}
  >
    {
      OPTIONS.map((option) => {
        const key = THEME_KEYS[option.value];
        return (
          <label class="theme-switch__option" title={option.label}>
            <input
              type="radio"
              name="theme"
              value={option.value}
              checked={current === option.value}
              aria-label={option.label}
              data-i18n-attr-title-key={key}
              data-i18n-attr-title-en={TRANSLATIONS.en[key]}
              data-i18n-attr-title-zh={TRANSLATIONS.zh[key]}
              data-i18n-attr-title-ja={TRANSLATIONS.ja[key]}
              data-i18n-attr-aria-label-key={key}
              data-i18n-attr-aria-label-en={TRANSLATIONS.en[key]}
              data-i18n-attr-aria-label-zh={TRANSLATIONS.zh[key]}
              data-i18n-attr-aria-label-ja={TRANSLATIONS.ja[key]}
            />
            <Icon name={option.icon} size={15} class="theme-switch__icon" />
          </label>
        );
      })
    }
  </div>
</fieldset>
