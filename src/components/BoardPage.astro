---
// SPEC §15 — Latest, Trending and Featured share one implementation; only the ordering
// differs. Kept as a single component so the boards cannot drift.
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { listPublishedArticles, type PublicSort } from '../db/public';
import { i18nSpread } from '../lib/i18n';

export interface Props {
  sort: PublicSort;
  heading: string;
  path: string;
  description: string;
}

const { sort, heading, path, description } = Astro.props;
const db = env.DB as unknown as D1Database;

const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
// Twelve rather than the twenty the archive pages use. A card is tall enough that twenty
// of them is three screens of scrolling before the pager comes into view, and on a board
// whose whole job is browsing, reaching the controls matters more than packing a page.
// `hasMore` keys off this same constant, so the last page's "is there another" is right
// by construction rather than by a second literal to keep in step.
const PER_PAGE = 12;

const articles = await listPublishedArticles(db, { sort, limit: PER_PAGE, offset: (page - 1) * PER_PAGE });
const hasMore = articles.length === PER_PAGE;

const basePath = path;
const prevHref = page > 1 ? `${basePath}?page=${page - 1}` : null;
const nextHref = hasMore ? `${basePath}?page=${page + 1}` : null;
---

<Base title={heading} description={description} path={path}>
  <SiteHeader>
    {/*
      No hero on the boards either, for the same reason as the homepage: the heading
      restated what the nav already says and cost a screen of scrolling before the first
      card. `heading` still drives the document title and the `h1` below, which is
      visually hidden rather than removed — a board with no `h1` is a page a screen reader
      announces as untitled.
    */}
    <h1 class="sr-only">{heading}</h1>

    {
      articles.length === 0 ? (
        <div class="empty-state">
          <h2 {...i18nSpread('board.empty')}>Nothing here yet</h2>
          <p>
            <span {...i18nSpread('board.emptyBody')}>No published articles match this board. Import and publish some from the</span>{' '}
            <a href="/admin" {...i18nSpread('board.admin')}>admin</a>
            <span {...i18nSpread('board.orCheck')}>, or check</span> <a href="/latest" {...i18nSpread('board.latest')}>Latest</a>.
          </p>
        </div>
      ) : (
        <>
          <div class="grid-cards">
            {articles.map((a, i) => (
              <ArticleCard article={a} rank={sort === 'trending' ? i + 1 : undefined} />
            ))}
          </div>

          {/*
            The number sits at the left edge and both controls at the right. The `auto`
            margin on the number is what does the pushing — `justify-content: space-between`
            would place these three children at left, centre and right, which strands the
            newer link in the middle with the number. The empty `<span>` placeholders the
            old order needed, to keep space-between's three slots filled, go with it: with
            an auto margin there is nothing to pad out, so a board on its first page simply
            has no newer link.
          */}
          {(prevHref || nextHref) && (
            <nav class="pager">
              <span class="muted" {...i18nSpread('board.page', { page })}>Page {page}</span>
              {prevHref && <a href={prevHref} {...i18nSpread('board.newer')}>← Newer</a>}
              {nextHref && <a href={nextHref} {...i18nSpread('board.older')}>Older →</a>}
            </nav>
          )}
        </>
      )
    }
  </SiteHeader>
</Base>
