---
// SPEC §17.3 — the header is the primary navigation between the four boards
// (SPEC §15) and the categories (SPEC §13.5).
import { listCategoriesWithCounts } from '../db/public';
import { env } from 'cloudflare:workers';
import ThemeSwitch from './ThemeSwitch.astro';
import Icon from './Icon.astro';
import type { IconName } from '../icons/phosphor';

const SITE_NAME = (env.SITE_NAME as string) || 'X Article Hub';

/**
 * The theme the reader last chose, read from the same cookie the inline script in
 * Base.astro writes, so the control renders already holding the right option.
 *
 * `system` is the default and is also what an unrecognised stored value collapses
 * to. A stored value is validated rather than trusted because it is a cookie the
 * client controls: anything that is not one of the three states is treated as no
 * choice, and a cookie containing markup or a stray quote must never reach the
 * `checked` comparison or the `value` attribute.
 */
const THEME_COOKIE = 'xah_theme';
const theme = (() => {
  const raw = Astro.cookies.get(THEME_COOKIE)?.value;
  return raw === 'light' || raw === 'dark' || raw === 'system' ? raw : 'system';
})();

const path = Astro.url.pathname;

/**
 * Home, plus the three boards of SPEC §15, plus Authors. Not the seven entries this used
 * to have.
 *
 * `Search` and `About` were removed from the nav; neither page was removed. About is
 * still one click away in the footer, and `/search` is still what the header's search box
 * submits to. Neither needed a permanent slot in the primary row: they are destinations
 * rather than the places a reader moves between, and five items did the same job seven did.
 *
 * `Authors` is the reverse case, and the reason it earns a slot those two did not: it is
 * the only way to browse the archive by *who wrote it*, which is the organising principle a
 * reader reaches for right after finishing something they liked. `/author/*` has been
 * reachable from every card's byline for a while, but there was no way in from the
 * navigation — you had to already know whose name to look for.
 *
 * That is not only a decluttering argument either way. The row runs out of room before the
 * nav does, and `.nav` is `flex: 1` with `overflow-x: auto` — so when space runs short the
 * nav *scrolls*, silently, with no affordance. Anything else placed beside it (the §43
 * account slot, before it lost its label) pushes in the same direction, so this went back
 * through the same fit measurement the earlier changes did rather than being assumed to fit.
 *
 * The icons are chosen against what each board actually orders by. `/latest` is
 * `published_at DESC` — a question of *when*, so a clock — and `/trending` is the weighted
 * blend — a question of *how much*, so a flame. `/featured` is the editor's flag, which is
 * not a score at all.
 *
 * `Rising` and its `trend-up` glyph are gone. It ordered by `velocity_score` alone, and
 * that signal no longer exists: it needed two metric snapshots to compute, so every new
 * article scored 0 in it, and with one provider of engagement data the board was a second
 * ordering of the same column. Its entry is removed here, the page itself is deleted, and
 * the glyph went with them rather than being left vendored with no destination.
 *
 * Typed as `IconName` rather than `string` so a typo or an icon that was never
 * vendored fails the build instead of rendering an empty box next to a label.
 */
const nav: Array<{ href: string; label: string; icon: IconName }> = [
  { href: '/', label: 'Home', icon: 'house' },
  { href: '/featured', label: 'Featured', icon: 'star' },
  { href: '/latest', label: 'Latest', icon: 'clock' },
  { href: '/trending', label: 'Trending', icon: 'fire' },
  { href: '/authors', label: 'Authors', icon: 'users' },
];

const categories = await listCategoriesWithCounts(env.DB as unknown as D1Database);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      {/*
        Two rasters, one shown per theme. The mark is near-black by construction,
        so on the dark ground it is not low contrast, it is absent, and a CSS filter
        is not the answer: inverting the gold star sends it through the complement to
        teal, which on this palette is the accent colour, so it would read as
        interface rather than as artwork.

        Both are decorative — the site name follows as text, so the link is announced
        once, by that text — hence `alt=""`. The `width`/`height` attributes carry
        each PNG's own dimensions so the flex row reserves the right box before the
        images land. They are the square of the canvas, not of the mark inside it:
        sizing by the artwork's own extent would reserve a box 2% narrower than the
        one the browser reserves, and the mark would jump on every load that raced.
      */}
      <img class="logo-mark" src="/logo-mark.png" width="72" height="72" alt="" decoding="async" />
      <img
        class="logo-mark logo-mark-inverse"
        src="/logo-mark-inverse.png"
        width="72"
        height="72"
        alt=""
        decoding="async"
      />
      <span class="logo-text">{SITE_NAME}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} class:list={['nav-item', { active: isActive(item.href) }]}>
            <Icon name={item.icon} size={18} class="nav-icon" />
            {item.label}
          </a>
        ))
      }
    </nav>

    <form class="search-mini" action="/search" method="get" role="search">
      <input type="search" name="q" placeholder="Search articles" aria-label="Search articles" />
    </form>

    <ThemeSwitch current={theme} />

    {/*
      SPEC §43 — the account slot.

      This is the one place on the site where two readers see different HTML, and it is
      deliberately *not* rendered per reader. src/middleware.ts gives the homepage
      `s-maxage=60` and article pages `s-maxage=3600`, so any per-reader markup would be
      baked into a cached document and handed to everybody — one reader's name in another
      reader's page header. `Vary: Cookie` would fix that and cost nearly all of the
      cache hit rate, because every session becomes its own cache entry.

      So the markup below is identical for every reader: a plain link to /account. This
      script upgrades it to the reader's avatar when there is one.

      **The avatar is the whole representation.** The display name is deliberately not
      shown here, which means the link has no visible text and therefore needs an explicit
      `aria-label` — without one, a screen reader announces a bare "link" and the control
      is unusable non-visually. That label is why the name still reaches the DOM at all,
      and why the `textContent` guard in the script is load-bearing rather than
      ceremonial.

      No `title` attribute, deliberately: it would put the name back on screen on hover,
      which is the thing being removed.

      The degradation is unchanged and still harmless: with JavaScript off the slot reads
      "Sign in" — a link that still works, not a broken control — and /account is
      server-rendered, so signing in and out never depends on this script.
    */}
    <span class="auth-slot" data-auth-slot>
      <a class="nav-item auth-link" href="/account">Sign in</a>
    </span>
  </div>

  <script is:inline>
    (function () {
      var slot = document.querySelector('[data-auth-slot]');
      if (!slot) return;
      fetch('/auth/me', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
        .then(function (res) {
          return res.ok ? res.json() : null;
        })
        .then(function (body) {
          if (!body || !body.user) return;
          var name = (body.user.displayName || '').trim();

          /*
            SPEC §43 — a menu, not a link.

            The avatar used to be an `<a>` straight to /account. It now opens a menu with
            Saved and Account, which makes it a `<button>`: an anchor that does not navigate
            is a lie to a screen reader, and it breaks middle-click, the context menu and
            "open in new tab" for the one item that *is* navigational. The two destinations
            are real links inside the menu.
          */
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'nav-item auth-link auth-trigger';
          // Never displayed, and still required: the visible content is an image with an
          // empty alt, so this is the control's only accessible name.
          button.setAttribute('aria-label', name ? 'Account menu: ' + name : 'Account menu');
          button.setAttribute('aria-haspopup', 'true');
          button.setAttribute('aria-expanded', 'false');

          if (body.user.avatarUrl) {
            var avatar = document.createElement('img');
            avatar.className = 'auth-avatar';
            avatar.src = body.user.avatarUrl;
            avatar.alt = '';
            avatar.width = 20;
            avatar.height = 20;
            avatar.loading = 'lazy';
            avatar.decoding = 'async';
            button.appendChild(avatar);
          } else {
            // Google can return no picture, and `avatar_url` is nullable by schema. With the
            // name gone, an avatar-only slot with nothing in it would leave a signed-in
            // reader no indication at all that they are signed in — the silent failure this
            // codebase keeps having to guard against. So the first character stands in.
            var letter = document.createElement('span');
            letter.className = 'auth-avatar auth-avatar-letter';
            letter.textContent = (name || '?').charAt(0).toUpperCase();
            button.appendChild(letter);
          }

          var menu = document.createElement('div');
          menu.className = 'auth-menu';
          menu.hidden = true;

          var savedLink = document.createElement('a');
          savedLink.className = 'auth-menu-item';
          savedLink.href = '/saved';
          savedLink.textContent = 'Saved';

          var accountLink = document.createElement('a');
          accountLink.className = 'auth-menu-item';
          accountLink.href = '/account';
          accountLink.textContent = 'Account';

          /*
            SPEC §16 — the admin entry, for an account that has the role.

            Rendered from `body.user.role`, which `/auth/me` already returns, so this is a
            display decision rather than a second permission check. It is *only* a display
            decision: `/admin` is gated server-side by `requireAdmin`, which reads the role
            from the `users` row on every request. Hiding the link from a reader who is not
            an admin keeps a door out of their sight; it is not what keeps it locked, and
            nothing here should be read as if it were.
          */
          menu.appendChild(savedLink);
          menu.appendChild(accountLink);

          if (body.user.role === 'admin') {
            var adminLink = document.createElement('a');
            adminLink.className = 'auth-menu-item auth-menu-item-admin';
            adminLink.href = '/admin';
            adminLink.textContent = 'Admin';
            menu.appendChild(adminLink);
          }

          slot.replaceChildren(button, menu);
          slot.setAttribute('data-auth-state', 'signed-in');

          /*
            Toggle, dismiss on Escape, dismiss on an outside click.

            Nothing here is required to sign in, sign out or reach either destination —
            /account and /saved are server-rendered and reachable by URL — so a reader whose
            script fails loses a shortcut rather than an ability.
          */
          function close() {
            menu.hidden = true;
            button.setAttribute('aria-expanded', 'false');
          }
          function open() {
            menu.hidden = false;
            button.setAttribute('aria-expanded', 'true');
          }
          button.addEventListener('click', function (event) {
            event.stopPropagation();
            if (menu.hidden) { open(); } else { close(); }
          });
          document.addEventListener('click', function (event) {
            if (menu.hidden) return;
            if (!slot.contains(event.target)) close();
          });
          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !menu.hidden) { close(); button.focus(); }
          });
        })
        .catch(function () {
          // Offline, or the request failed. The signed-out link is already there and
          // still works, so there is nothing to repair and nothing worth saying.
        });
    })();
  </script>

  <div class="wrap category-bar" aria-label="Categories">
    {
      categories.map(
        (c) => (
          <a href={`/category/${c.slug}`} class:list={['cat-chip', { active: path === `/category/${c.slug}` }]}>
            {c.name}
            <span class="cat-count">{c.count}</span>
          </a>
        ),
      )
    }
  </div>
</header>

<main class="wrap main">
  <slot />
</main>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>
      {SITE_NAME} — human-curated X Articles, archived and indexed on Cloudflare.
    </p>
    <p class="footer-links">
      <a href="/about">About</a>
      <a href="/feed.xml">RSS</a>
      <a href="/sitemap.xml">Sitemap</a>
      <a href="/admin">Admin</a>
    </p>
  </div>
</footer>
