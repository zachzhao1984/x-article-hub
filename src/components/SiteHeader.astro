---
// SPEC §17.3 — the header is the primary navigation between the four boards
// (SPEC §15) and the categories (SPEC §13.5).
import { listCategoriesWithCounts } from '../db/public';
import { env } from 'cloudflare:workers';
import ThemeSwitch from './ThemeSwitch.astro';
import LangSwitch from './LangSwitch.astro';
import Icon from './Icon.astro';
import type { IconName } from '../icons/phosphor';
import { LANG_COOKIE, SITE_LANGS, i18nSpread, i18nAttrSpread, TRANSLATIONS } from '../lib/i18n';
import type { SiteLang, TranslationKey } from '../lib/i18n';

const SITE_NAME = (env.SITE_NAME as string) || 'X Article Hub';

/**
 * The theme the reader last chose, read from the same cookie the inline script in
 * Base.astro writes, so the control renders already holding the right option.
 *
 * `system` is the default and is also what an unrecognised stored value collapses
 * to. A stored value is validated rather than trusted because it is a cookie the
 * client controls: anything that is not one of the three states is treated as no
 * choice, and a cookie containing markup or a stray quote must never reach the
 * `checked` comparison or the `value` attribute.
 */
const THEME_COOKIE = 'xah_theme';
const theme = (() => {
  const raw = Astro.cookies.get(THEME_COOKIE)?.value;
  return raw === 'light' || raw === 'dark' || raw === 'system' ? raw : 'system';
})();

const path = Astro.url.pathname;

/**
 * SPEC §17.4 — the reader's language, read from the same cookie `LANG_SCRIPT` writes, so the
 * switcher renders already holding the right option.
 *
 * Validated rather than trusted, like the theme value below it: it is a cookie the client
 * controls, so anything that is not one of the three languages is treated as no choice.
 */
const lang: SiteLang = (() => {
  const raw = Astro.cookies.get(LANG_COOKIE)?.value;
  return (SITE_LANGS as readonly string[]).includes(raw ?? '') ? (raw as SiteLang) : 'en';
})();

/**
 * Home, plus the three boards of SPEC §15, plus Authors. Not the seven entries this used
 * to have.
 *
 * `Search` and `About` were removed from the nav; neither page was removed. About is
 * still one click away in the footer, and `/search` is still what the header's search box
 * submits to. Neither needed a permanent slot in the primary row: they are destinations
 * rather than the places a reader moves between, and five items did the same job seven did.
 *
 * `Authors` is the reverse case, and the reason it earns a slot those two did not: it is
 * the only way to browse the archive by *who wrote it*, which is the organising principle a
 * reader reaches for right after finishing something they liked. `/author/*` has been
 * reachable from every card's byline for a while, but there was no way in from the
 * navigation — you had to already know whose name to look for.
 *
 * That is not only a decluttering argument either way. The row runs out of room before the
 * nav does, and `.nav` is `flex: 1` with `overflow-x: auto` — so when space runs short the
 * nav *scrolls*, silently, with no affordance. Anything else placed beside it (the §43
 * account slot, before it lost its label) pushes in the same direction, so this went back
 * through the same fit measurement the earlier changes did rather than being assumed to fit.
 *
 * The icons are chosen against what each board actually orders by. `/latest` is
 * `published_at DESC` — a question of *when*, so a clock — and `/trending` is the weighted
 * blend — a question of *how much*, so a flame. `/featured` is the editor's flag, which is
 * not a score at all.
 *
 * `Rising` and its `trend-up` glyph are gone. It ordered by `velocity_score` alone, and
 * that signal no longer exists: it needed two metric snapshots to compute, so every new
 * article scored 0 in it, and with one provider of engagement data the board was a second
 * ordering of the same column. Its entry is removed here, the page itself is deleted, and
 * the glyph went with them rather than being left vendored with no destination.
 *
 * Typed as `IconName` rather than `string` so a typo or an icon that was never
 * vendored fails the build instead of rendering an empty box next to a label.
 */
const nav: Array<{ href: string; label: string; icon: IconName; key: TranslationKey }> = [
  { href: '/', label: 'Home', icon: 'house', key: 'nav.home' },
  { href: '/featured', label: 'Featured', icon: 'star', key: 'nav.featured' },
  { href: '/latest', label: 'Latest', icon: 'clock', key: 'nav.latest' },
  { href: '/trending', label: 'Trending', icon: 'fire', key: 'nav.trending' },
  { href: '/authors', label: 'Authors', icon: 'users', key: 'nav.authors' },
];

const categories = await listCategoriesWithCounts(env.DB as unknown as D1Database);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

/**
 * The category the reader is currently inside, so the filter holds its value.
 *
 * Read from the path rather than from a `?category=` parameter because the destination *is* a
 * category page: selecting a category navigates to `/category/<slug>`, which is the URL a
 * reader can bookmark, share and reach with the back button. Mirroring the path also means the
 * control is correct on a category page without any query string at all, and stays correct
 * after a server-side render with no JavaScript.
 *
 * Validated against the loaded list before use — the path segment is client-supplied in the
 * sense that anything can be requested, and it is compared for equality against known slugs
 * rather than concatenated into markup.
 */
const activeCategory = (() => {
  const match = /^\/category\/([^/]+)\/?$/.exec(path);
  const slug = match?.[1] ? decodeURIComponent(match[1]) : '';
  return categories.some((c) => c.slug === slug) ? slug : '';
})();
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      {/*
        Two rasters, one shown per theme. The dark X needs a light variant
        against dark headers; the article card and blue image keep their colours.

        Both are decorative — the site name follows as text, so the link is announced
        once, by that text — hence `alt=""`. The `width`/`height` attributes carry
        each PNG's own dimensions so the flex row reserves the right box before the
        images land. Both use the same square canvas.
      */}
      <img class="logo-mark" src="/logo-mark.png" width="96" height="96" alt="" decoding="async" />
      <img
        class="logo-mark logo-mark-inverse"
        src="/logo-mark-inverse.png"
        width="96"
        height="96"
        alt=""
        decoding="async"
      />
      <span class="logo-text">{SITE_NAME}</span>
    </a>

    <nav class="nav" {...i18nAttrSpread('aria-label', 'nav.primary')}>
      {
        nav.map((item) => (
          <a href={item.href} class:list={['nav-item', { active: isActive(item.href) }]}>
            <Icon name={item.icon} size={18} class="nav-icon" />
            <span {...i18nSpread(item.key)}>{item.label}</span>
          </a>
        ))
      }
    </nav>

    {/*
      SPEC §15 — categories as a filter, not a row.

      The five chips used to occupy their own full-width line under the header. That line was
      the first thing to make the header tall on a laptop, and it separated the search box from
      the navigation by a rule, so the two things a reader uses to *narrow* the archive sat far
      apart. A `<select>` puts the filter next to the search it composes with, costs a fixed
      width instead of the sum of five chips, and is a single control a keyboard reaches in one
      stop.

      A native `<select>` rather than a custom listbox on purpose: it is focusable and
      arrow-key operable everywhere with no JavaScript, and it collapses to the platform control
      on mobile.

      It carries no `name`, so it is never submitted with the search form beside it: choosing a
      category *navigates* to `/category/<slug>`, which is the archive's own, sortable,
      bookmarkable view of it. Submitting `?category=…&q=…` to `/search` instead would ship a
      parameter the results page has no way to honour — the reader would see a search that
      silently ignored half of what they asked for.

      The chevron is a masked sibling rather than a `background` image on the select itself, for
      two reasons. A data-URI SVG has to name its stroke colour, so it was hardcoded and could
      not follow the theme or invert when the control marks the current category. And a
      background image on the select would have to be re-declared per state, doubling a value
      that a mask inherits for free from `currentColor`.

      `is-active` marks the category the reader is already on. Without it the control is
      pixel-identical whether it says "All topics" or the page you are standing in, so the one
      place the header states the current category never looked like it was stating anything.
    */}
    <div class="search-mini">
      <div class={activeCategory ? 'category-filter is-active' : 'category-filter'}>
        <select
          class="category-select"
          aria-label="Filter by category"
          data-i18n-aria-key="nav.categories"
          data-i18n-aria-en={TRANSLATIONS.en["nav.categories"]}
          data-i18n-aria-zh={TRANSLATIONS.zh["nav.categories"]}
          data-i18n-aria-ja={TRANSLATIONS.ja['nav.categories']}
          onchange="location.href = this.value ? '/category/' + this.value : '/'"
        >
          <option value="" selected={!activeCategory} {...i18nSpread('nav.allTopics')}>All topics</option>
          {
            categories.map(
              (c) => (
                <option value={c.slug} selected={activeCategory === c.slug}>
                  {c.name}
                </option>
              ),
            )
          }
        </select>
        <span class="category-filter__chevron" aria-hidden="true" />
      </div>

      <form action="/search" method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder="Search articles"
          aria-label="Search articles"
          data-i18n-placeholder-key="header.search.placeholder"
          data-i18n-placeholder-en={TRANSLATIONS.en["header.search.placeholder"]}
          data-i18n-placeholder-zh={TRANSLATIONS.zh["header.search.placeholder"]}
          data-i18n-placeholder-ja={TRANSLATIONS.ja['header.search.placeholder']}
          data-i18n-aria-key="header.search.label"
          data-i18n-aria-en={TRANSLATIONS.en["header.search.label"]}
          data-i18n-aria-zh={TRANSLATIONS.zh["header.search.label"]}
          data-i18n-aria-ja={TRANSLATIONS.ja['header.search.label']}
        />
      </form>
    </div>

    <LangSwitch current={lang} />

    <ThemeSwitch current={theme} />

    {/*
      SPEC §43 — the account slot.

      This is the one place on the site where two readers see different HTML, and it is
      deliberately *not* rendered per reader. src/middleware.ts gives the homepage
      `s-maxage=60` and article pages `s-maxage=3600`, so any per-reader markup would be
      baked into a cached document and handed to everybody — one reader's name in another
      reader's page header. `Vary: Cookie` would fix that and cost nearly all of the
      cache hit rate, because every session becomes its own cache entry.

      So the markup below is identical for every reader: a plain link to /account. This
      script upgrades it to the reader's avatar when there is one.

      **The avatar is the whole representation.** The display name is deliberately not
      shown here, which means the link has no visible text and therefore needs an explicit
      `aria-label` — without one, a screen reader announces a bare "link" and the control
      is unusable non-visually. That label is why the name still reaches the DOM at all,
      and why the `textContent` guard in the script is load-bearing rather than
      ceremonial.

      No `title` attribute, deliberately: it would put the name back on screen on hover,
      which is the thing being removed.

      The degradation is unchanged and still harmless: with JavaScript off the slot reads
      "Sign in" — a link that still works, not a broken control — and /account is
      server-rendered, so signing in and out never depends on this script.
    */}
    <span class="auth-slot" data-auth-slot>
      <a class="nav-item auth-link" href="/account" {...i18nSpread('header.signIn')}>Sign in</a>
    </span>
  </div>

  <script is:inline define:vars={{ authText: {
    accountMenu: TRANSLATIONS.en['header.accountMenu'],
    accountMenuNamed: TRANSLATIONS.en['header.accountMenuNamed'],
    saved: TRANSLATIONS.en['header.menu.saved'],
    account: TRANSLATIONS.en['header.menu.account'],
    admin: TRANSLATIONS.en['header.menu.admin'],
  }, authI18n: {
    saved: i18nSpread('header.menu.saved'),
    account: i18nSpread('header.menu.account'),
    admin: i18nSpread('header.menu.admin'),
    accountMenu: i18nSpread('header.accountMenu'),
    // Required by the `tr('accountMenuNamed')` call below. It was in `authText` but not here,
    // so `tr` indexed `undefined` and threw on `['data-i18n-en']` — and the trailing `.catch`
    // swallows errors silently, so a signed-in reader simply had no avatar and nothing
    // anywhere said why.
    accountMenuNamed: i18nSpread('header.accountMenuNamed'),
  }, lang: lang }}>
    (function () {
      var slot = document.querySelector('[data-auth-slot]');
      if (!slot) return;
      // SPEC §17.4 — the menu items are created in the reader's language. The three labels
      // come from the same catalog the server rendered, so the script and the markup cannot
      // disagree about what a menu item is called.
      function tr(key) {
        var el = authI18n[key];
        return lang === 'en' ? el['data-i18n-en'] : (el['data-i18n-' + lang] || el['data-i18n-en']);
      }
      function applyI18n(el, key) {
        var attrs = authI18n[key];
        for (var k in attrs) { if (attrs.hasOwnProperty(k)) el.setAttribute(k, attrs[k]); }
      }
      fetch('/auth/me', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
        .then(function (res) {
          return res.ok ? res.json() : null;
        })
        .then(function (body) {
          if (!body || !body.user) return;
          var name = (body.user.displayName || '').trim();

          /*
            SPEC §43 — a menu, not a link.

            The avatar used to be an `<a>` straight to /account. It now opens a menu with
            Saved and Account, which makes it a `<button>`: an anchor that does not navigate
            is a lie to a screen reader, and it breaks middle-click, the context menu and
            "open in new tab" for the one item that *is* navigational. The two destinations
            are real links inside the menu.
          */
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'nav-item auth-link auth-trigger';
          // Never displayed, and still required: the visible content is an image with an
          // empty alt, so this is the control's only accessible name.
          button.setAttribute('aria-label', name ? tr('accountMenuNamed').replace('{name}', name) : tr('accountMenu'));
          button.setAttribute('aria-haspopup', 'true');
          button.setAttribute('aria-expanded', 'false');

          if (body.user.avatarUrl) {
            var avatar = document.createElement('img');
            avatar.className = 'auth-avatar';
            avatar.src = body.user.avatarUrl;
            avatar.alt = '';
            avatar.width = 20;
            avatar.height = 20;
            avatar.loading = 'lazy';
            avatar.decoding = 'async';
            button.appendChild(avatar);
          } else {
            // Google can return no picture, and `avatar_url` is nullable by schema. With the
            // name gone, an avatar-only slot with nothing in it would leave a signed-in
            // reader no indication at all that they are signed in — the silent failure this
            // codebase keeps having to guard against. So the first character stands in.
            var letter = document.createElement('span');
            letter.className = 'auth-avatar auth-avatar-letter';
            letter.textContent = (name || '?').charAt(0).toUpperCase();
            button.appendChild(letter);
          }

          var menu = document.createElement('div');
          menu.className = 'auth-menu';
          menu.hidden = true;

          var savedLink = document.createElement('a');
          savedLink.className = 'auth-menu-item';
          savedLink.href = '/saved';
          savedLink.textContent = tr('saved');
          applyI18n(savedLink, 'saved');

          var accountLink = document.createElement('a');
          accountLink.className = 'auth-menu-item';
          accountLink.href = '/account';
          accountLink.textContent = tr('account');
          applyI18n(accountLink, 'account');

          /*
            SPEC §16 — the admin entry, for an account that has the role.

            Rendered from `body.user.role`, which `/auth/me` already returns, so this is a
            display decision rather than a second permission check. It is *only* a display
            decision: `/admin` is gated server-side by `requireAdmin`, which reads the role
            from the `users` row on every request. Hiding the link from a reader who is not
            an admin keeps a door out of their sight; it is not what keeps it locked, and
            nothing here should be read as if it were.
          */
          menu.appendChild(savedLink);
          menu.appendChild(accountLink);

          if (body.user.role === 'admin') {
            var adminLink = document.createElement('a');
            adminLink.className = 'auth-menu-item auth-menu-item-admin';
            adminLink.href = '/admin';
            adminLink.textContent = tr('admin');
            applyI18n(adminLink, 'admin');
            menu.appendChild(adminLink);
          }

          slot.replaceChildren(button, menu);
          slot.setAttribute('data-auth-state', 'signed-in');

          /*
            Toggle, dismiss on Escape, dismiss on an outside click.

            Nothing here is required to sign in, sign out or reach either destination —
            /account and /saved are server-rendered and reachable by URL — so a reader whose
            script fails loses a shortcut rather than an ability.
          */
          function close() {
            menu.hidden = true;
            button.setAttribute('aria-expanded', 'false');
          }
          function open() {
            menu.hidden = false;
            button.setAttribute('aria-expanded', 'true');
          }
          button.addEventListener('click', function (event) {
            event.stopPropagation();
            if (menu.hidden) { open(); } else { close(); }
          });
          document.addEventListener('click', function (event) {
            if (menu.hidden) return;
            if (!slot.contains(event.target)) close();
          });
          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !menu.hidden) { close(); button.focus(); }
          });
        })
        .catch(function (error) {
          // Offline, or the request failed. The signed-out link is already there and still
          // works, so there is nothing to repair — but the error is *reported*, not swallowed.
          //
          // It used to be silent, and that is how a signed-in reader lost their avatar with
          // nothing anywhere saying why: `tr('accountMenuNamed')` read a key missing from
          // `authI18n`, threw on `undefined['data-i18n-en']`, and this handler ate it. A
          // caught-and-ignored error in a UI upgrade path is invisible by construction, so
          // anything that reaches here says so.
          if (window.console && console.warn) {
            console.warn('[auth-slot] could not render the account control:', error);
          }
        });
    })();
  </script>

</header>

<main class="wrap main" id="main-content">
  <slot />
</main>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>
      {SITE_NAME} — <span {...i18nSpread('footer.tagline')}>human-curated X Articles, archived and indexed on Cloudflare.</span>
    </p>
    <p class="footer-links">
      <a href="/about" {...i18nSpread('footer.about')}>About</a>
      <a href="/feed.xml" {...i18nSpread('footer.rss')}>RSS</a>
      <a href="/sitemap.xml" {...i18nSpread('footer.sitemap')}>Sitemap</a>
      <a href="/admin" {...i18nSpread('footer.admin')}>Admin</a>
    </p>
  </div>
</footer>
