{
  "name": "x-article-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Curated, archived and searchable hub for X Articles. Built entirely on Cloudflare.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "deploy:dry": "npm run build && wrangler deploy -c dist/server/wrangler.json --dry-run",
    "cf-typegen": "cf workers types",
    "typecheck": "cf workers types && astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "cf d1 migrations apply 61f1e63b-4097-49fb-a99d-1f05dcb69ad9 --local --dir migrations",
    "db:migrate:remote": "cf d1 migrations apply 61f1e63b-4097-49fb-a99d-1f05dcb69ad9 --remote --dir migrations",
    "db:query": "cf d1 query 61f1e63b-4097-49fb-a99d-1f05dcb69ad9 --local",
    "smoke": "bash scripts/smoke.sh",
    "smoke:site": "bash scripts/smoke-site.sh",
    "cleanup": "bash scripts/cleanup-smoke.sh",
    "db:query:remote": "cf d1 query 61f1e63b-4097-49fb-a99d-1f05dcb69ad9"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "astro": "^7.4.0",
    "hono": "^4.7.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "cf": "^1.0.0-beta.16",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260815.1": true
  }
}
