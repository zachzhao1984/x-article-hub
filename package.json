{
  "name": "x-article-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Curated, archived and searchable hub for X Articles. Built entirely on Cloudflare.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "deploy:dry": "npm run build && wrangler deploy -c dist/server/wrangler.json --dry-run",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply x-article-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply x-article-hub --remote",
    "db:query": "wrangler d1 execute x-article-hub --local",
    "smoke": "bash scripts/smoke.sh",
    "smoke:site": "bash scripts/smoke-site.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "fsevents@2.3.3": true
  }
}
