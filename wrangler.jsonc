{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "x-article-hub",

  // Custom entrypoint (see src/worker.ts). Needed because the adapter's default
  // entrypoint cannot export the `queue` / `scheduled` handlers (SPEC §19 / §21).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": true,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "x-articles.840727.xyz",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Cloudflare Browser Run binding.
  // Required by SPEC §7 / §30. Wired now (Phase 0) so the crawl job in Phase 2
  // has a browser available without another config change.
  // `remote: true` because Quick Actions only run in remote mode.
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-article-hub",
      "database_id": "61f1e63b-4097-49fb-a99d-1f05dcb69ad9",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "x-article-archive"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "ARTICLE_INGEST_QUEUE",
        "queue": "article-ingest"
      },
      {
        "binding": "ARTICLE_PROCESS_QUEUE",
        "queue": "article-process"
      },
      {
        "binding": "ARTICLE_METRICS_QUEUE",
        "queue": "article-metrics"
      }
    ],
    "consumers": [
      {
        "queue": "article-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "article-ingest-dlq"
      },
      {
        "queue": "article-process",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 5
      }
    ]
  },

  // SPEC §3 — Astro builds to ./dist. The adapter's `cf()` middleware serves
  // hashed build assets from here and falls through to SSR for everything else,
  // so no run_worker_first list is needed.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // SPEC §21 — the ranking refresh.
  //
  // Every 30 minutes. The cadence is set by how fast `final_score` can actually go stale:
  // it changes when a crawl lands, and crawls are manual and measured in articles per day
  // rather than per hour, so a tighter schedule would mostly recompute an unchanged set.
  // Thirty minutes is also well inside the window where a reader would notice a newly
  // popular article still ranked by yesterday's engagement.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  "vars": {
    "SITE_NAME": "X Article Hub",
    "SITE_ORIGIN": "https://x-articles.840727.xyz",
    "RANKING_WEIGHTS_JSON": "{\"popularity\":0.57,\"quality\":0.29,\"editor\":0.14}",
    "MAX_IMPORT_URLS": "200",
    "CRAWL_SCREENSHOT": "false"
  }
}
